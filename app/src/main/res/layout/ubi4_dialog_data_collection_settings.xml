<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:viewBindingIgnore="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/dialogBindingCV"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        android:backgroundTint="@color/ubi4_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainDialogCl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/dataCollectionSettingsTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/sf_pro_text_bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/data_passport_settings"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- N_CYCLES слайдер -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/nCyclesDialogCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/dataCollectionSettingsTitleTv">

                <!-- Заголовок слайдера -->
                <TextView
                    android:id="@+id/nCyclesSliderTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="N_CYCLES"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Текущее значение слайдера -->
                <TextView
                    android:id="@+id/nCyclesSliderNumTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/nCyclesSliderTitleTv" />

                <!-- Кнопка "-" -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nCyclesMinusBtnCl"
                    android:layout_width="48dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/nCyclesSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/nCyclesSliderSb">

                    <View
                        android:id="@+id/nCyclesMinusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/nCyclesMinusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="-"
                        android:layout_marginBottom="2dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/nCyclesMinusBtnRipple"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_ripple_corners"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck"
                        tools:targetApi="s" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- SeekBar слайдера -->
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/nCyclesSliderSb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="10"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="3"
                    android:progressDrawable="@drawable/ubi4_track"
                    android:thumb="@drawable/thumb_le"
                    app:layout_constraintStart_toEndOf="@+id/nCyclesMinusBtnCl"
                    app:layout_constraintTop_toBottomOf="@+id/nCyclesSliderTitleTv"
                    app:layout_constraintEnd_toStartOf="@+id/nCyclesPlusBtnCl" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/nCyclesPlusBtnCl"
                    android:layout_width="48dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/nCyclesSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/nCyclesSliderSb"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:id="@+id/nCyclesPlusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/nCyclesPlusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/nCyclesPlusBtnRipple"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_ripple_corners"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck"
                        tools:targetApi="s" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BASELINE_DURATION слайдер -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/baselineDurationDialogCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
