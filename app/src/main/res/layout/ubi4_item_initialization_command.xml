<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        style="@style/Ubi4Surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ubi4_view_with_corners_gray_outside"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/commandTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ubi4_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/commandHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/ubi4_text_muted"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sendCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/v3_init_command_send"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/commandQueued"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/v3_init_command_queued"
            android:textColor="@color/ubi4_active_foreground"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
