        android:layout_height="24dp"
        android:layout_alignStart="@+id/ubi4BackBtn"
        android:layout_alignTop="@+id/ubi4BackBtn"
        android:layout_alignEnd="@+id/ubi4BackBtn"
        android:layout_alignBottom="@+id/ubi4BackBtn"
        android:layout_margin="6dp"
        android:src="@drawable/ic_arrow_left"
        android:visibility="gone"
        app:tint="@color/ubi4_white"
        tools:ignore="ContentDescription" />

    <View
