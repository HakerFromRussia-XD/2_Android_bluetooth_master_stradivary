                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="5"
                    android:progressDrawable="@drawable/ubi4_track"
                    android:thumb="@drawable/thumb_le"
                    app:layout_constraintStart_toEndOf="@+id/baselineDurationMinusBtnCl"
                    app:layout_constraintTop_toBottomOf="@+id/baselineDurationSliderTitleTv"
                    app:layout_constraintEnd_toStartOf="@+id/baselineDurationPlusBtnCl" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/baselineDurationPlusBtnCl"
                    android:layout_width="48dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/baselineDurationSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/baselineDurationSliderSb"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:id="@+id/baselineDurationPlusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/baselineDurationPlusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="+"
