                                                                        <subviews>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="За что отвечает чувствительность?" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="gaO-vw-9Gx">
                                                                                <rect key="frame" x="0.0" y="0.0" width="350" height="22"/>
                                                                                <fontDescription key="fontDescription" name="Inter-Regular_SemiBold" family="Inter" pointSize="18"/>
                                                                                <color key="textColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="4La-8h-bxb">
                                                                                <rect key="frame" x="0.0" y="38" width="350" height="114.5"/>
                                                                                <string key="text">Чувствительность определяет то, как сильно нужно напрягать мышцу, чтобы датчик считал сигнал. Уменьшать чувствительность необходимо при большом фоновом шуме, увеличивать, если мышцу приходится черезмерно сильно напрягать при управлении протезом.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Перетаскивая эти слайдеры, можно менять уровни чувствительности датчиков." lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="IgI-mI-g0i">
                                                                                <rect key="frame" x="0.0" y="168.5" width="350" height="38.5"/>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
