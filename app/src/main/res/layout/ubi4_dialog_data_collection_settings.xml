                <!-- Заголовок слайдера -->
                <TextView
                    android:id="@+id/postGestDurationSliderTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="POST_GEST_DURATION"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Текущее значение слайдера -->
                <TextView
                    android:id="@+id/postGestDurationSliderNumTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/postGestDurationSliderTitleTv" />

                <!-- Кнопка "-" -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/postGestDurationMinusBtnCl"
                    android:layout_width="48dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/postGestDurationSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/postGestDurationSliderSb">

                    <View
                        android:id="@+id/postGestDurationMinusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/postGestDurationMinusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="-"
                        android:layout_marginBottom="2dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/postGestDurationMinusBtnRipple"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_ripple_corners"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck"
                        tools:targetApi="s" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- SeekBar слайдера -->
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/postGestDurationSliderSb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="5"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="2"
                    android:progressDrawable="@drawable/ubi4_track"
                    android:thumb="@drawable/thumb_le"
                    app:layout_constraintStart_toEndOf="@+id/postGestDurationMinusBtnCl"
                    app:layout_constraintTop_toBottomOf="@+id/postGestDurationSliderTitleTv"
                    app:layout_constraintEnd_toStartOf="@+id/postGestDurationPlusBtnCl" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/postGestDurationPlusBtnCl"
                    android:layout_width="48dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/postGestDurationSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/postGestDurationSliderSb"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:id="@+id/postGestDurationPlusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/postGestDurationPlusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/postGestDurationPlusBtnRipple"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_ripple_corners"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck"
                        tools:targetApi="s" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/view3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/ubi4_gray_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/postGestDurationDialogCl" />

            <TextView
                android:id="@+id/tv_andex_alert_dialog_gestures_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_light"
                android:text="@string/title_home"
                android:textColor="@color/ubi4_white"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="@+id/dialogDataCollectionSettingsGesturesBtn"
                app:layout_constraintEnd_toEndOf="@+id/dialogDataCollectionSettingsGesturesBtn"
                app:layout_constraintStart_toStartOf="@+id/dialogDataCollectionSettingsGesturesBtn"
                app:layout_constraintTop_toTopOf="@+id/dialogDataCollectionSettingsGesturesBtn" />

            <View
                android:id="@+id/dialogDataCollectionSettingsGesturesBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view3"
                tools:ignore="SpeakableTextPresentCheck" />

            <View
                android:id="@+id/view11_0"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ubi4_gray_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialogDataCollectionSettingsGesturesBtn" />

            <TextView
                android:id="@+id/tv_andex_alert_dialog_save_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_text_bold"
                android:text="@string/save_gripper_settings"
                android:textColor="@color/ubi4_yes_system_blue"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/dialogDataCollectionSettingsSaveBtn"
                app:layout_constraintEnd_toEndOf="@+id/dialogDataCollectionSettingsSaveBtn"
                app:layout_constraintStart_toStartOf="@+id/dialogDataCollectionSettingsSaveBtn"
                app:layout_constraintTop_toTopOf="@+id/dialogDataCollectionSettingsSaveBtn" />

            <View
                android:id="@+id/dialogDataCollectionSettingsSaveBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view11_0"
                tools:ignore="SpeakableTextPresentCheck" />

            <View
                android:id="@+id/view11"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ubi4_gray_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialogDataCollectionSettingsSaveBtn" />

            <TextView
                android:id="@+id/tv_andex_alert_dialog_cancel_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_light"
                android:text="@string/cancel_gripper_settings"
                android:textColor="@color/ubi4_yes_system_blue"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="@+id/dialogDataCollectionSettingsCancelBtn"
                app:layout_constraintEnd_toEndOf="@+id/dialogDataCollectionSettingsCancelBtn"
                app:layout_constraintStart_toStartOf="@+id/dialogDataCollectionSettingsCancelBtn"
                app:layout_constraintTop_toTopOf="@+id/dialogDataCollectionSettingsCancelBtn" />

            <View
                android:id="@+id/dialogDataCollectionSettingsCancelBtn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view11" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>