            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- AT_GEST_DURATION слайдер -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/atGestDurationDialogCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/preGestDurationDialogCl">

                <!-- Заголовок слайдера -->
                <TextView
                    android:id="@+id/atGestDurationSliderTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="AT_GEST_DURATION"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Текущее значение слайдера -->
