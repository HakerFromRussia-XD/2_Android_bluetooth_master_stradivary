<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:viewBindingIgnore="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/dialogBindingCV"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        android:backgroundTint="@color/ubi4_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainDialogCl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/gesturesTitleTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/sf_pro_text_bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/organize_the_gestures"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/gesturesDialogCl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/gesturesTitleTv">

                <com.woxthebox.draglistview.DragListView
                    android:id="@+id/gesturesDragLv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ubi4_view_with_corners_gray_outside"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:listitem="@layout/ubi4_item_gesture_card"/>

                <View
                    android:id="@+id/view3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/ubi4_gray_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/gesturesDragLv" />

                <TextView
                    android:id="@+id/tv_andex_alert_dialog_gestures_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="@string/add"
                    android:textColor="@color/ubi4_white"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="@+id/addGestureBtn"
                    app:layout_constraintEnd_toEndOf="@+id/addGestureBtn"
                    app:layout_constraintStart_toStartOf="@+id/addGestureBtn"
                    app:layout_constraintTop_toTopOf="@+id/addGestureBtn" />

                <View
                    android:id="@+id/addGestureBtn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view3"
                    tools:ignore="SpeakableTextPresentCheck" />

                <View
                    android:id="@+id/view11_0"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ubi4_gray_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/addGestureBtn" />

                <TextView
                    android:id="@+id/tv_andex_alert_dialog_save_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_text_bold"
                    android:text="@string/save_gripper_settings"
                    android:textColor="@color/ubi4_yes_system_blue"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/saveGesturesBtn"
                    app:layout_constraintEnd_toEndOf="@+id/saveGesturesBtn"
                    app:layout_constraintStart_toStartOf="@+id/saveGesturesBtn"
                    app:layout_constraintTop_toTopOf="@+id/saveGesturesBtn" />

                <View
                    android:id="@+id/saveGesturesBtn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view11_0"
                    tools:ignore="SpeakableTextPresentCheck" />

                <View
                    android:id="@+id/view11"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ubi4_gray_border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/saveGesturesBtn" />

                <TextView
                    android:id="@+id/tv_andex_alert_dialog_cancel_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_light"
                    android:text="@string/cancel_gripper_settings"
                    android:textColor="@color/ubi4_yes_system_blue"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="@+id/cancelGesturesBtn"
                    app:layout_constraintEnd_toEndOf="@+id/cancelGesturesBtn"
                    app:layout_constraintStart_toStartOf="@+id/cancelGesturesBtn"
                    app:layout_constraintTop_toTopOf="@+id/cancelGesturesBtn" />

                <View
                    android:id="@+id/cancelGesturesBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view11" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>