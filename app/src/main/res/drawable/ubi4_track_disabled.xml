<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- background track -->
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/ubi4_gray"/>
            <size android:height="30dp"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="@color/ubi4_gray_border"/>
        </shape>
    </item>

    <!-- progress track (disabled: also gray, but can be slightly different if хочешь) -->
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="@color/ubi4_gray_border"/>
                <size android:height="30dp"/>
                <corners android:radius="10dp"/>
            </shape>
        </scale>
    </item>

</layer-list>