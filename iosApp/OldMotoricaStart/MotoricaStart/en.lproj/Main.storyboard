                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" ambiguous="YES" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ZKP-5b-sAT">
                                                                                <rect key="frame" x="0.0" y="336" width="350" height="49"/>
                                                                                <string key="text">To use the configured gesture, press the button corresponding to the gesture. It will become white (different from all other buttons).</string>
