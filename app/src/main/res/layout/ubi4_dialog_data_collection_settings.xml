                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- SeekBar слайдера -->
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/preGestDurationSliderSb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="5"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="2"
                    android:progressDrawable="@drawable/ubi4_track"
                    android:thumb="@drawable/thumb_le"
                    app:layout_constraintStart_toEndOf="@+id/preGestDurationMinusBtnCl"
                    app:layout_constraintTop_toBottomOf="@+id/preGestDurationSliderTitleTv"
                    app:layout_constraintEnd_toStartOf="@+id/preGestDurationPlusBtnCl" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/preGestDurationPlusBtnCl"
                    android:layout_width="48dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/preGestDurationSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/preGestDurationSliderSb"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:id="@+id/preGestDurationPlusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/preGestDurationPlusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <View
                        android:id="@+id/preGestDurationPlusBtnRipple"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_ripple_corners"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck"
