<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app ="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp">

    <!-- 1. Название платы (как ubi4_bms_version_tv) -->
    <TextView
        android:id="@+id/board_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_open_sans_regular"
        android:layout_marginStart="16dp"
        android:textColor="@color/ubi4_white"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Board 08"
        />

    <TextView
        android:id="@+id/boardVerTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/ubi4_white"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/bootloderStatusTv"
        app:layout_constraintBaseline_toBaselineOf="@id/board_name_tv"
        tools:text="1.922" />

    <TextView
        android:id="@+id/bootloderStatusTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginStart="12dp"
        android:visibility="invisible"
        android:textColor="@color/ubi4_white"
        android:textSize="12sp"
        android:text="▷"
        app:layout_constraintEnd_toStartOf="@+id/bootloader_actions"
        app:layout_constraintBaseline_toBaselineOf="@id/board_name_tv"/>

    <LinearLayout
        android:id="@+id/bootloader_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/update_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_open_sans_semi_bold"
            android:text="@string/update_firmware"
            android:textColor="@color/ubi4_white"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/bootloader_settings_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/service_settings"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_settings_24"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Divider (тот же цвет/отступы) -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@color/ubi4_gray_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
