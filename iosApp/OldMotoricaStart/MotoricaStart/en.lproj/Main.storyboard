                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="mZF-V8-0LL">
                                                                                <rect key="frame" x="0.0" y="631" width="350" height="65.5"/>
                                                                                <string key="text">If the prosthetic hand closes into a fist, then it is calibrated correctly. If it does not close in the fist or does not move, you should contact the service center for consultation.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                        </subviews>
                                                                        <constraints>
                                                                            <constraint firstAttribute="trailing" secondItem="5pu-z3-pYg" secondAttribute="trailing" id="NAG-uL-zly"/>
                                                                            <constraint firstAttribute="height" constant="696.5" id="XYS-4o-wR6"/>
                                                                            <constraint firstItem="PU7-ko-oYK" firstAttribute="leading" secondItem="6LP-qD-R2y" secondAttribute="leading" id="hwO-jp-SfZ"/>
                                                                            <constraint firstItem="5pu-z3-pYg" firstAttribute="leading" secondItem="6LP-qD-R2y" secondAttribute="leading" id="kkV-AV-bhM"/>
                                                                            <constraint firstAttribute="trailing" secondItem="PU7-ko-oYK" secondAttribute="trailing" id="mFf-jI-lXr"/>
                                                                        </constraints>
                                                                    </stackView>
                                                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="LcN-4M-09t">
                                                                        <rect key="frame" x="0.0" y="728.5" width="350" height="1802.5"/>
                                                                        <subviews>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="259" text="Configuring your first personal gesture" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="WpF-E0-tlu">
                                                                                <rect key="frame" x="0.0" y="0.0" width="350" height="21"/>
                                                                                <fontDescription key="fontDescription" name="Inter-Regular_SemiBold" family="Inter" pointSize="18"/>
                                                                                <color key="textColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="256" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="IS7-JW-2Uu">
                                                                                <rect key="frame" x="0.0" y="37" width="350" height="65.5"/>
                                                                                <string key="text">After checking that the calibration and the first gesture are working, you can start setting up your own gestures. To do this, click on the gear button next to the name of the gesture you want to adjust.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="help_image_16_us" adjustsImageSizeForAccessibilityContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="myU-Mr-Ahf">
                                                                                <rect key="frame" x="0.0" y="118.5" width="350" height="200"/>
                                                                                <constraints>
                                                                                    <constraint firstAttribute="width" secondItem="myU-Mr-Ahf" secondAttribute="height" multiplier="7:4" id="g3J-tt-l0l"/>
                                                                                </constraints>
                                                                            </imageView>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="259" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="XBs-jr-dTB">
                                                                                <rect key="frame" x="0.0" y="334.5" width="350" height="65.5"/>
                                                                                <string key="text">This will open a window in which you will see a 3D model of the prosthetic hand in the open state of the customizable gesture. Change the grip by tapping any finger and then swiping up or down on the screen.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="help_image_17" adjustsImageSizeForAccessibilityContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="71P-um-iUQ">
                                                                                <rect key="frame" x="0.0" y="416" width="350" height="289"/>
                                                                                <constraints>
                                                                                    <constraint firstAttribute="width" secondItem="71P-um-iUQ" secondAttribute="height" multiplier="4:3.3" id="IZX-NJ-iAk"/>
                                                                                </constraints>
                                                                            </imageView>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="255" text="The length of the swipe adjusts the angle of the finger bend." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Fuj-tD-Rqi">
                                                                                <rect key="frame" x="0.0" y="721" width="350" height="33"/>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="252" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="0Sh-fR-hD0">
                                                                                <rect key="frame" x="0.0" y="770" width="350" height="65.5"/>
                                                                                <string key="text">When adjusting the forefinger, middle finger, ring finger, and pinky finger, only the swipe in the vertical direction is taken into consideration. And two axes are used simultaneously to adjust the position of the thumb.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSansRoman-SemiBold" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="258" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Tut-aN-eF3">
                                                                                <rect key="frame" x="0.0" y="851.5" width="350" height="49"/>
                                                                                <string key="text">The vertical axis control the angle of flexion of the thumb itself, and the horizontal axis control the angle of rotation of the thumb.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Swipes outside the hand rotate it in space." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="vxq-00-fLL">
                                                                                <rect key="frame" x="0.0" y="916.5" width="350" height="144.5"/>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="254" text="At the bottom of the screen there is a button to switch the grip of the customizable gesture." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="CNZ-RL-kHg">
                                                                                <rect key="frame" x="0.0" y="1077" width="350" height="33"/>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="help_image_18_us" adjustsImageSizeForAccessibilityContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lR7-ok-RTy">
                                                                                <rect key="frame" x="0.0" y="1126" width="350" height="200"/>
                                                                                <constraints>
                                                                                    <constraint firstAttribute="width" secondItem="lR7-ok-RTy" secondAttribute="height" multiplier="7:4" id="C88-H2-8tq"/>
                                                                                </constraints>
                                                                            </imageView>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="258" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lYe-qc-Ecy">
                                                                                <rect key="frame" x="0.0" y="1342" width="350" height="65.5"/>
                                                                                <string key="text">If the open and closed positions of the prosthetic fingers do not match, after pressing it you will see an animation of the grip that will be applied when using this gesture.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="253" text="In real life, the prosthetic will perform the same finger movements as the model on the smartphone screen." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="8RC-NW-PIF">
                                                                                <rect key="frame" x="0.0" y="1423.5" width="350" height="33"/>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="257" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="OAT-hL-tNV">
                                                                                <rect key="frame" x="0.0" y="1472.5" width="350" height="49"/>
                                                                                <string key="text">By moving the model's fingers when the gesture state button is in the "closed state" position you will configure the closed position of the gesture.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="259" text="You can also enter your own name for the gesture by clicking on the pencil icon next to the default gesture name." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="o6n-Sb-1t1">
                                                                                <rect key="frame" x="0.0" y="1537.5" width="350" height="49"/>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
                                                                                <nil key="highlightedColor"/>
                                                                            </label>
