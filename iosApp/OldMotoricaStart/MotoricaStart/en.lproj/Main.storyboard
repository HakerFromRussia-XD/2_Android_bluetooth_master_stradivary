                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" ambiguous="YES" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="KyN-Hs-XAA">
                                                                                <rect key="frame" x="0.0" y="55" width="350" height="49"/>
                                                                                <string key="text">After reaching the desired open and closed position of the gesture, you must press the "save" button located at the bottom of the screen.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
                                                                                <color key="textColor" name="deselected_text_filter"/>
