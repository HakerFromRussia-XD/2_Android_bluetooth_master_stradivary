                        app:layout_constraintEnd_toStartOf="@+id/ubi4EndGuideline2"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toBottomOf="@+id/ubi4TextView71" />

                </androidx.constraintlayout.widget.ConstraintLayout>
