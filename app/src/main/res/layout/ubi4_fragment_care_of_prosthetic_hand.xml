                app:cardElevation="0dp"
                app:cardCornerRadius="12dp"
                app:layout_constraintEnd_toStartOf="@+id/ubi4EndGuideline"
                app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline"
                app:layout_constraintTop_toBottomOf="@+id/ubi4HelpTitleInContentTv">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ubi4_view_with_corners_gray_outside">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/ubi4BeginGuideline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_begin="16dp" />
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/ubi4EndGuideline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_end="16dp" />
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/ubi4TopGuideline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_begin="20dp" />
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/ubi4BottomGuideline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_end="20dp" />

                    <TextView
                        android:id="@+id/ubi4TextView16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_inter_semi_bold"
                        android:text="@string/prostheses_care"
                        android:textSize="24sp"
                        android:textColor="@color/ubi4_white"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toTopOf="@+id/ubi4TopGuideline2" />


                    <TextView
                        android:id="@+id/ubi4TextView17"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font_open_sans_regular"
                        android:text="@string/check_the_technical_condition_of_your_prostheses_at_regular_intervals_if_you_find_faults_cracks_or_other_malfunctions_contact_the_service_center_or_your_dentist"
                        android:textColor="@color/ubi4_deactivate_text"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="@+id/ubi4EndGuideline2"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toBottomOf="@+id/ubi4TextView16" />

                    <TextView
                        android:id="@+id/ubi4TextView22"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font_open_sans_regular"
                        android:text="@string/regular_maintenance_of_the_prostheses_is_required_refer_to_service_and_warranty_for_service_intervals"
                        android:textColor="@color/ubi4_deactivate_text"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="@+id/ubi4EndGuideline2"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toBottomOf="@+id/ubi4TextView17" />



                    <TextView
                        android:id="@+id/ubi4TextView26"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font_open_sans_regular"
                        android:text="@string/it_is_recommended_to_clean_the_arm_prostheses_regularly_use_a_squeezed_cotton_swab_soaked_in_3_hydrogen_peroxide_solution_or_moist_alcohol_wipes_for_this_purpose"
                        android:textColor="@color/ubi4_deactivate_text"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="@+id/ubi4EndGuideline2"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toBottomOf="@+id/ubi4TextView22" />

                    <TextView
                        android:id="@+id/ubi4TextView21"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font_open_sans_semi_bold"
                        android:text="@string/do_not_use_aggressive_detergents"
                        android:textColor="@color/ubi4_deactivate_text"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="@+id/ubi4EndGuideline2"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toBottomOf="@+id/ubi4TextView26" />

                    <TextView
                        android:id="@+id/ubi4TextView71"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font_open_sans_regular"
                        android:text="@string/if_you_have_a_cosmetic_shell_installed_check_it_regularly_for_through_damage_try_to_avoid_contact_with_sharp_or_pointed_objects_if_the_cosmetic_shell_needs_to_be_replaced_please_contact_your_prosthetic_company"
                        android:textColor="@color/ubi4_deactivate_text"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="@+id/ubi4EndGuideline2"
                        app:layout_constraintStart_toStartOf="@+id/ubi4BeginGuideline2"
                        app:layout_constraintTop_toBottomOf="@+id/ubi4TextView21" />

                    <TextView
                        android:id="@+id/ubi4TextView23"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font_inter_semi_bold"
                        android:text="@string/important_do_not_try_to_repair_your_prosthetic_arm_yourself_it_may_cause_more_serious_damage_and_void_your_warranty"
