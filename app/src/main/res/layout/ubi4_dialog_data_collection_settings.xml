                    android:id="@+id/atGestDurationSliderSb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="5"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progress="2"
                    android:progressDrawable="@drawable/ubi4_track"
                    android:thumb="@drawable/thumb_le"
                    app:layout_constraintStart_toEndOf="@+id/atGestDurationMinusBtnCl"
                    app:layout_constraintTop_toBottomOf="@+id/atGestDurationSliderTitleTv"
                    app:layout_constraintEnd_toStartOf="@+id/atGestDurationPlusBtnCl" />

                <androidx.constraintlayout.widget.ConstraintLayout
