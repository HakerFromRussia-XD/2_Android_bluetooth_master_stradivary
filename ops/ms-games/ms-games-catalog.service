[Unit]
Description=MS games validated catalog publisher
After=local-fs.target

[Service]
Type=simple
User=ms-upload
Group=ms-staging
WorkingDirectory=/usr/local/lib/ms-games
ExecStart=/usr/bin/python3 /usr/local/lib/ms-games/catalog_watcher.py
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ms-firmware/games
ReadOnlyPaths=/srv/ms-firmware/staging/games
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
CPUQuota=10%
TasksMax=16

[Install]
WantedBy=multi-user.target
