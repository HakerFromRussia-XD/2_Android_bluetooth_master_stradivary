                                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" ambiguous="YES" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="hHQ-U4-Woq">
                                                                                <rect key="frame" x="0.0" y="604" width="350" height="65.5"/>
                                                                                <string key="text">In this example, the first gesture is selected as the starting gesture and the fourth as the ending gesture. If the start gesture is set larger than the end gesture, the system will swap them.</string>
                                                                                <fontDescription key="fontDescription" name="OpenSans-Regular" family="Open Sans" pointSize="14"/>
