                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/font_open_sans_regular"
                        android:text="1. "
                        android:textColor="@color/ubi4_deactivate_text"
                        android:textSize="14sp"
