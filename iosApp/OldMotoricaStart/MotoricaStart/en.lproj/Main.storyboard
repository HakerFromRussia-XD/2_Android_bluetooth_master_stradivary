                                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="32" translatesAutoresizingMaskIntoConstraints="NO" id="B3j-g8-Kus">
                                                <rect key="frame" x="16" y="0.0" width="382" height="1108"/>
