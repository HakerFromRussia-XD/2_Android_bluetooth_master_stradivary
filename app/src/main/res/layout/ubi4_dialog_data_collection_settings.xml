                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@+id/atGestDurationSliderSb"
                    app:layout_constraintBottom_toBottomOf="@+id/atGestDurationSliderSb"
                    app:layout_constraintEnd_toEndOf="parent">

                    <View
                        android:id="@+id/atGestDurationPlusBtnBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ubi4_view_with_corners_gray_outside"
                        android:elevation="0dp" />

                    <TextView
                        android:id="@+id/atGestDurationPlusBtnTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="4dp"
                        android:fontFamily="@font/sf_pro_display_light"
                        android:text="+"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="3dp"
                        app:layout_constraintTop_toTopOf="parent"
