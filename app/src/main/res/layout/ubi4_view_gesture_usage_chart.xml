<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ubi4_back"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/gestureUsageRootLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ubi4_view_with_corners_back_inside"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/gestureUsageTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_light"
            android:gravity="start"
            android:text="@string/gesture_usage_chart_title"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:ignore="RtlSymmetry" />

        <FrameLayout
            android:id="@+id/gestureUsageChartContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/gestureUsagePieChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/gestureUsageEmptyTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/sf_pro_display_light"
                android:text="@string/gesture_usage_empty"
                android:textColor="@color/ubi4_deactivate_text"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/gestureUsageLegendLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
