    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ubi4_back">

    <View
        android:id="@+id/ubi4TitleClickBlockBtn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/ubi4MainSv"
        android:layout_alignParentTop="true"
        android:background="@color/ubi4_back" />

    <View
        android:id="@+id/ubi4BackBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="6dp"
        android:layout_marginTop="18dp"
        android:background="?android:attr/selectableItemBackground"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ubi4ImageView33"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignStart="@id/ubi4BackBtn"
        android:layout_alignTop="@id/ubi4BackBtn"
        android:layout_alignEnd="@id/ubi4BackBtn"
        android:layout_alignBottom="@id/ubi4BackBtn"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_arrow_left"
        android:visibility="gone"
        app:tint="@color/ubi4_white"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/ubi4HelpTitleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/ubi4ImageView33"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/font_open_sans_semi_bold"
        android:lines="2"
        android:text="@string/gesture_settings"
        android:textColor="@color/ubi4_white"
        android:textSize="18sp"
        android:visibility="gone" />

