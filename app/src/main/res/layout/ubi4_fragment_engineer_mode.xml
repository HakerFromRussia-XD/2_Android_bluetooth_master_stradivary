<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ubi4_back"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/dataCollectionBtn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ubi4_viwe_with_corners_white"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/dataCollectionBtnTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:fontFamily="@font/sf_pro_text_bold"
        android:text="@string/data_collection"
        android:textColor="@color/ubi4_dark_back"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/dataCollectionBtn"
        app:layout_constraintEnd_toEndOf="@id/dataCollectionBtn"
        app:layout_constraintStart_toStartOf="@id/dataCollectionBtn"
        app:layout_constraintTop_toTopOf="@id/dataCollectionBtn"/>

    <View
        android:id="@+id/inferenceBtn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ubi4_viwe_with_corners_white"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dataCollectionBtn"/>

    <TextView
        android:id="@+id/inferenceBtnTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:fontFamily="@font/sf_pro_text_bold"
        android:text="@string/inference"
        android:textColor="@color/ubi4_dark_back"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/inferenceBtn"
        app:layout_constraintEnd_toEndOf="@id/inferenceBtn"
        app:layout_constraintStart_toStartOf="@id/inferenceBtn"
        app:layout_constraintTop_toTopOf="@id/inferenceBtn"/>

</androidx.constraintlayout.widget.ConstraintLayout>